<div class="dash-hero">
  <div class="dash-hero-top">
    <div>
      <div class="dash-hero-number"><%= stats[:total_hours].round(1) %></div>
      <div class="dash-hero-caption">of <%= stats[:hours_goal] %> hours · <%= format_duration(stats[:hours_needed]) %> to go</div>
    </div>
    <div class="dash-hero-finish">
      <div class="dash-hero-finish-label">Projected finish</div>
      <div class="dash-hero-finish-value"><%= stats[:projected_finish] %></div>
    </div>
  </div>

  <% goal = stats[:hours_goal].to_f %>
  <div class="<%= class_names("dash-hero-progress", "is-revealing" => local_assigns[:reveal]) %>">
    <div class="dash-hero-bar dash-hero-bar-day" style="width: <%= [ stats[:day_hours] / goal * 100, 100 ].min %>%"></div>
    <div class="dash-hero-bar dash-hero-bar-night" style="width: <%= [ stats[:night_hours] / goal * 100, 100 ].min %>%"></div>
  </div>

  <div class="dash-hero-chips">
    <%= link_to all_drive_sessions_path(kind: "day"), class: "dash-hero-chip is-day",
                aria: { label: "Day #{stats[:day_hours].round(1)} hours — show drives with daytime hours" } do %>
      <span class="dash-hero-chip-key">Day</span>
      <span class="dash-hero-chip-value"><%= stats[:day_hours].round(1) %></span>
    <% end %>
    <%= link_to all_drive_sessions_path(kind: "night"), class: "dash-hero-chip is-night",
                aria: { label: "Night #{stats[:night_hours].round(1)} of #{stats[:night_hours_goal]} hours — show drives with night hours" } do %>
      <span class="dash-hero-chip-key">Night</span>
      <span class="dash-hero-chip-value"><%= stats[:night_hours].round(1) %> <small>/ <%= stats[:night_hours_goal] %></small></span>
    <% end %>
    <div class="dash-hero-chip">
      <span class="dash-hero-chip-key">Pace</span>
      <span class="dash-hero-chip-value"><%= stats[:weekly_pace] %> <small>h/wk</small></span>
    </div>
    <%= link_to all_drive_sessions_path, class: "dash-hero-chip",
                aria: { label: "Drives #{stats[:drives_count]} — show every drive" } do %>
      <span class="dash-hero-chip-key">Drives</span>
      <span class="dash-hero-chip-value"><%= stats[:drives_count] %></span>
    <% end %>
  </div>
</div>
