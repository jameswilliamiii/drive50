<div class="activity-card">
  <div class="activity-card-header">
    <span class="activity-card-title">Momentum</span>
    <span class="activity-card-sub">last 3 weeks</span>
  </div>

  <div class="activity-card-body">
    <div class="activity-top">
      <div class="activity-statement">
        <div class="activity-streak">
          <div class="activity-streak-number"><%= stats[:current_streak] %></div>
          <div class="activity-streak-meta">
            <div class="activity-streak-label">Day streak</div>
            <div class="activity-streak-best">Best <b><%= pluralize(stats[:best_streak], "day") %></b></div>
          </div>
        </div>
      </div>

      <div class="activity-cal">
      <div class="activity-weekdays">
        <% %w[S M T W T F S].each do |label| %><span><%= label %></span><% end %>
      </div>
      <div class="activity-grid">
        <% cells.each do |cell| %>
          <% if cell.future? && !cell.any_drives? %>
            <div class="activity-cell state-none is-future"
                 title="<%= cell.date.strftime("%B %d, %Y") %>"></div>
          <% else %>
            <%# A real button rather than a div: the grid becomes keyboard
                reachable and Enter/Space activate it for free, so this needs no
                keydown handler of its own (unlike the drive rows). A future day
                still gets one if a drive was logged against it, otherwise the
                cell would be coloured but impossible to inspect. %>
            <button type="button"
                    class="activity-cell state-<%= cell.state %><%= " is-today" if cell.today? %><%= " is-future" if cell.future? %>"
                    title="<%= cell.date.strftime("%B %d, %Y") %>"
                    aria-label="<%= cell.aria_label %>"
                    aria-haspopup="dialog"
                    data-day-summary="<%= cell.to_json %>"
                    data-action="day-modal#open"></button>
          <% end %>
        <% end %>
      </div>
      <div class="activity-legend">
        <span><span class="activity-swatch is-day"></span>Day</span>
        <span><span class="activity-swatch is-night"></span>Night</span>
        <span><span class="activity-swatch is-both"></span>Both</span>
      </div>
      </div>
    </div>

    <p class="activity-sentence">
      You've driven <b><%= stats[:active_days] %> of the last 21</b> days.
    </p>

    <div class="activity-ministats">
      <div class="activity-ministat">
        <span class="activity-ministat-key">This week</span>
        <span class="activity-ministat-value"><%= format_duration_short(stats[:this_week_hours]) %></span>
      </div>
      <div class="activity-ministat">
        <span class="activity-ministat-key">Last week</span>
        <span class="activity-ministat-value"><%= format_duration_short(stats[:last_week_hours]) %></span>
      </div>
    </div>
  </div>
</div>
