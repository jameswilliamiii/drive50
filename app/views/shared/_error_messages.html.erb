<%
  only ||= nil
  messages = only ? Array(only).flat_map { |attr| object.errors.where(attr).map(&:full_message) } : object.errors.full_messages
%>
<% if messages.any? %>
  <div class="error-messages">
    <h3><%= pluralize(messages.count, "error") %> prevented this <%= object_name || object.model_name.human.downcase %> from being saved:</h3>
    <ul>
      <% messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  </div>
<% end %>
