<%
  back_path ||= nil
  subtitle ||= nil
%>
<div class="page-header">
  <% if back_path %>
    <%= link_to back_path, class: "page-header-back", aria: { label: "Back" } do %>
      <%= icon_arrow_left(size: 24, class: "page-header-icon") %>
    <% end %>
  <% end %>
  <div class="page-header-text">
    <h1 class="page-header-title"><%= title %></h1>
    <% if subtitle %>
      <p class="page-header-subtitle"><%= subtitle %></p>
    <% end %>
  </div>
</div>
